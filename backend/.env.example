# ============================================================
# AI Knowledge Assistant - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=./uploads
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=knowledge_base

# --- Embedding Model ---
# Local HuggingFace model (no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- LLM Provider ---
# Options: huggingface_local | huggingface_api | openai_compatible
LLM_PROVIDER=huggingface_local

# Local model (downloaded on first use, ~1-4GB)
LLM_MODEL_ID=microsoft/phi-2
LLM_DEVICE=cpu
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1

# HuggingFace Inference API (optional)
# HUGGINGFACE_API_KEY=hf_your_key_here
# HF_INFERENCE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# OpenAI-compatible API (optional)
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo

# --- RAG Settings ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# --- Agent Settings ---
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=120

# --- Web Search (optional) ---
# SERPAPI_KEY=your_serpapi_key_here
# WEB_SEARCH_ENABLED=false

# --- Fine-Tuning (separate workflow) ---
FINETUNE_BASE_MODEL=facebook/opt-125m
FINETUNE_OUTPUT_DIR=./training/output
FINETUNE_DATASET=./training/datasets/sample_dataset.jsonl
